# Install as ~/.config/seqevi/seqevi-store.env with mode 0600.
# Use an immutable repository digest, never a mutable tag.
SEQEVI_IMAGE=192.168.30.202:23099/bioinfo/seqevi@sha256:replace-with-digest

# Keep credentials out of the unit file and repository.
SEQEVI_DATABASE_URL=postgresql+psycopg://seqevi:replace-with-password@127.0.0.1:15432/seqevi
# Pool checkout plus the PostgreSQL 17+ whole-transaction timeout must total no
# more than the 30-second database wait budget.
SEQEVI_DATABASE_POOL_SIZE=16
SEQEVI_DATABASE_MAX_OVERFLOW=8
SEQEVI_DATABASE_POOL_TIMEOUT_SECONDS=5
SEQEVI_DATABASE_LOCK_TIMEOUT_SECONDS=5
SEQEVI_DATABASE_STATEMENT_TIMEOUT_SECONDS=15
SEQEVI_DATABASE_TRANSACTION_TIMEOUT_SECONDS=25

# Existing service-owned host path and its exact mounted filesystem. The
# directory may be nested below the mount.
SEQEVI_ARTIFACTS_DIR=/absolute/path/to/seqevi/artifacts
SEQEVI_ARTIFACTS_MOUNT=/absolute/path/to/mounted/filesystem

# Numeric, non-root owner of the existing artifact directory.
SEQEVI_UID=1000
SEQEVI_GID=1000

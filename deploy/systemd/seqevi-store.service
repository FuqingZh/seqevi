[Unit]
Description=SeqEvi shared evidence Store
Documentation=https://github.com/FuqingZh/seqevi
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/.config/seqevi/seqevi-store.env

[Service]
Type=simple
EnvironmentFile=%h/.config/seqevi/seqevi-store.env
ExecStartPre=/usr/bin/test -n "${SEQEVI_IMAGE}"
ExecStartPre=/usr/bin/test "${SEQEVI_UID}" -gt 0
ExecStartPre=/usr/bin/test "${SEQEVI_GID}" -gt 0
ExecStartPre=/usr/bin/test -d "${SEQEVI_ARTIFACTS_DIR}"
ExecStartPre=/usr/bin/mountpoint --quiet "${SEQEVI_ARTIFACTS_MOUNT}"
ExecStartPre=/usr/bin/findmnt --mountpoint "${SEQEVI_ARTIFACTS_MOUNT}" --types ceph
ExecStartPre=/usr/bin/docker image inspect "${SEQEVI_IMAGE}"
ExecStartPre=-/usr/bin/docker rm --force seqevi-store
ExecStart=/usr/bin/docker run --name seqevi-store --network host --read-only --init --user ${SEQEVI_UID}:${SEQEVI_GID} --cap-drop ALL --security-opt no-new-privileges --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m --mount type=bind,src=${SEQEVI_ARTIFACTS_DIR},dst=/var/lib/seqevi/artifacts --env SEQEVI_DATABASE_URL --env SEQEVI_ARTIFACTS_DIR=/var/lib/seqevi/artifacts --env SEQEVI_HEALTH_URL=http://127.0.0.1:18081/health "${SEQEVI_IMAGE}" serve --host 127.0.0.1 --port 18081
ExecStop=/usr/bin/docker stop --time 30 seqevi-store
ExecStopPost=-/usr/bin/docker rm --force seqevi-store
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=45s

[Install]
WantedBy=default.target
